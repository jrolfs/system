# The repo's devenv shell (devenv.nix). direnv loads only the nearest .envrc,
# so a directory with its own gets that instead: kitty's devenv.nix imports
# this one's to keep Node and `audit`, while glide's flake shell does without.
eval "$(devenv direnvrc)"

use devenv

# Secrets a maintenance script reads from the environment (API keys and the
# like), kept out of the repo by .gitignore.
dotenv_if_exists .env.direnv

# Untracked per-machine additions, a full direnv file sourced last.
source_env_if_exists .envrc.local
