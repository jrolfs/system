{
  "document_symbols": "on",
  "close_on_file_delete": false,
  "seed_search_query_from_cursor": "selection",
  "use_smartcase_search": false,
  "search": {
    "button": true,
    "center_on_match": false,
    "regex": false,
    "case_sensitive": true
  },
  "minimum_split_diff_width": 200.0,
  "diff_view_style": "split",
  "proxy": "",
  "auto_install_extensions": {
    "color-highlight": true,
    "colored-zed-icons-theme": true,
    "deno": true,
    "dockerfile": true,
    "git-firefly": true,
    "glsl": true,
    "graphql": true,
    "gruvbox-material": true,
    "gruvbox-material-mix": true,
    "html": true,
    "jetbrains-new-ui-icons": true,
    "make": true,
    "markdown-oxide": true,
    "material-icon-theme": true,
    "mdx": true,
    "nix": true,
    "oxc": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "tsgo": true,
    "xml": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "excerpt_context_lines": 4,
  "file_finder": {
    "modal_max_width": "xlarge"
  },
  "show_wrap_guides": true,
  "indent_guides": {
    "background_coloring": "disabled",
    "line_width": 1,
    "active_line_width": 1
  },
  "languages": {
    "TypeScript": {
      "indent_guides": {
        "line_width": 0
      },
      "tab_size": 2
    }
  },
  "use_system_path_prompts": false,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 0.85
  },
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": false
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true
  },
  "tabs": {
    "show_diagnostics": "all",
    "activate_on_close": "left_neighbour",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_menu": true,
    "show_branch_status_icon": true
  },
  "vim": {
    "show_edit_predictions_in_normal_mode": true,
    "use_regex_search": false,
    "use_system_clipboard": "never",
    "cursor_shape": {
      "visual": "hollow",
      "replace": "hollow",
      "insert": "bar"
    },
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "toolbar": {
    "agent_review": false,
    "code_actions": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": true
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "search_results": true,
    "show": "auto"
  },
  "gutter": {
    "min_line_number_digits": 3
  },
  "show_signature_help_after_edits": false,
  "auto_signature_help": true,
  "vertical_scroll_margin": 5.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "expand_excerpt_lines": 6,
  "which_key": {
    "delay_ms": 500,
    "enabled": true
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "entry_spacing": "standard",
    "dock": "left",
    "show_diagnostics": "all"
  },
  "outline_panel": {
    "indent_size": 2.0,
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "terminal_init_command": "",
    "play_sound_when_agent_done": "when_hidden",
    "show_turn_stats": true,
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "group_by": "status",
    "tree_view": true,
    "show_count_badge": true,
    "fallback_branch_name": "main",
    "file_icons": true,
    "dock": "right"
  },
  "semantic_tokens": "combined",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "xhigh",
        "mode": "auto"
      },
      "type": "registry"
    },
    "Claude Foundry": {
      "type": "custom",
      "command": "/bin/zsh",
      "args": [
        "-c",
        "source ~/.config/zsh/init/keys.zsh && exec npx -y @agentclientprotocol/claude-agent-acp"
      ],
      "default_config_options": {
        "effort": "xhigh",
        "mode": "auto"
      },
      "env": {
        "ANTHROPIC_MODEL": "claude-opus-5"
      }
    }
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Material Custom Light",
    "dark": "Gruvbox Material Custom Dark"
  },
  "vim_mode": true,
  "ui_font_size": 13,
  "buffer_font_size": 12.0,
  "ui_font_family": "Geist",
  "buffer_font_family": "JetBrains Mono",
  "format_on_save": "off",
  "relative_line_numbers": "enabled",
  "terminal": {
    "font_family": "JetBrains Mono",
    "font_fallbacks": [
      "JetBrainsMono Nerd Font",
      "FiraCode Nerd Font"
    ]
  },
  "wrap_guides": [
    100
  ],
  "edit_predictions": {
    "mode": "eager",
    "provider": "zed"
  },
  "file_types": {
    "GitHub Actions": [
      "**/.github/workflows/*.yml",
      "**/.github/workflows/*.yaml"
    ]
  },
  "lsp": {
    "yaml-language-server": {
      "binary": {
        "path": "/run/current-system/sw/bin/yaml-language-server",
        "arguments": ["--stdio"]
      },
      "settings": {
        "yaml": {
          "schemas": {
            "https://json.schemastore.org/github-workflow.json": [
              "**/.github/workflows/*.yml",
              "**/.github/workflows/*.yaml"
            ],
            "https://json.schemastore.org/github-action.json": [
              "**/.github/actions/**/action.yml",
              "**/.github/actions/**/action.yaml"
            ]
          }
        }
      }
    }
  }
}
