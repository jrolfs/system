  "description": "The settings for a particular language.",
  "title": "UserSettingsContent",
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$defs": {
    "EditPredictionSettingsContent": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditPredictionProvider"
            },
            {
              "type": "null"
            }
          ],
          "description": "Determines which edit prediction provider to use."
        },
        "disabled_globs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SplicingVec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Disable edit predictions for files matching these glob patterns.\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged.\n\nRelative patterns are matched against paths relative to the worktree root.\nAbsolute patterns are matched against absolute paths. A leading `~` is\nexpanded to your home folder."
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditPredictionsMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "The mode used to display edit predictions in the buffer.\nProvider support required."
        },
        "copilot": {
          "anyOf": [
            {
              "$ref": "#/$defs/CopilotEditPredictionSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings specific to GitHub Copilot."
        },
        "codestral": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodestralSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings specific to Codestral."
        },
        "ollama": {
          "anyOf": [
            {
              "$ref": "#/$defs/OllamaEditPredictionSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings specific to Ollama."
        },
        "open_ai_compatible_api": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomEditPredictionProviderSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings specific to using custom OpenAI-compatible servers for edit prediction."
        },
        "zed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZedEditPredictionSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings specific to Zed's Edit Predictions provider."
        },
        "mercury": {
          "anyOf": [
            {
              "$ref": "#/$defs/MercuryEditPredictionSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings specific to the Mercury Edit Predictions provider."
        },
        "allow_data_collection": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditPredictionDataCollectionChoice"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controls whether Zed may collect training data when using Zed's Edit Predictions.\nData is only ever captured for files in projects that are detected as open source.\n\n- `\"default\"`: use the preference previously set via the status-bar toggle,\n  or false if no preference has been stored.\n- `\"yes\"`: allow data collection for files in open-source projects.\n- `\"no\"`: never allow data collection."
        }
      },
      "description": "The contents of the edit prediction settings.",
      "additionalProperties": false
    },
    "EditPredictionProvider": {
      "type": "string",
      "enum": [
        "none",
        "copilot",
        "zed",
        "codestral",
        "ollama",
        "open_ai_compatible_api",
        "mercury"
      ],
      "description": "The provider that supplies edit predictions."
    },
    "SplicingVec": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "EditPredictionsMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "subtle",
          "description": "If provider supports it, display inline when holding modifier key (e.g., alt).\nOtherwise, eager preview is used."
        },
        {
          "type": "string",
          "const": "eager",
          "description": "Display inline when there are no language server completions available."
        }
      ],
      "description": "The mode in which edit predictions should be displayed."
    },
    "CopilotEditPredictionSettingsContent": {
      "type": "object",
      "properties": {
        "proxy": {
          "type": [
            "string",
            "null"
          ],
          "description": "HTTP/HTTPS proxy to use for Copilot.\n\nDefault: none"
        },
        "proxy_no_verify": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Disable certificate verification for the proxy (not recommended).\n\nDefault: false"
        },
        "enable_next_edit_suggestions": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the Copilot Next Edit Suggestions feature is enabled.\n\nDefault: true"
        },
        "prediction_debounce": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 75"
        }
      },
      "additionalProperties": false
    },
    "CodestralSettingsContent": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model to use for completions.\n\nDefault: \"codestral-latest\""
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "Maximum tokens to generate.\n\nDefault: 150"
        },
        "api_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Api URL to use for completions.\n\nDefault: \"https://codestral.mistral.ai\""
        },
        "prediction_debounce": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
