    "InlineBlameSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: true"
        },
        "delay_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "Whether to only show the inline blame information\nafter a delay once the cursor stops moving.\n\nDefault: 0"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/InlineBlameLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to render the blame information when enabled.\n\nDefault: inline"
        },
        "padding": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "The amount of padding between the end of the source line and the start\nof the inline blame in units of columns.\n\nDefault: 7"
        },
        "min_column": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "The minimum column number to show the inline blame information at\n\nDefault: 0"
        },
        "show_commit_summary": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to show commit summary as part of the inline blame.\n\nDefault: false"
        }
      },
      "additionalProperties": false
    },
    "InlineBlameLocation": {
      "oneOf": [
        {
          "type": "string",
          "const": "inline",
          "description": "Show git blame inline at the current line."
        },
        {
          "type": "string",
          "const": "status_bar",
          "description": "Show git blame in the status bar at the bottom of the window."
        }
      ]
    },
    "BlameSettings": {
      "type": "object",
      "properties": {
        "show_avatar": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to show the avatar of the author of the commit.\n\nDefault: true"
        }
      },
      "additionalProperties": false
    },
    "BranchPickerSettingsContent": {
      "type": "object",
      "properties": {
        "show_author_name": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to show author name as part of the commit information.\n\nDefault: false"
        }
      },
      "additionalProperties": false
    },
    "FileDiffSettingsContent": {
      "type": "object",
      "properties": {
        "show_full_file": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether newly opened file diffs show the full file instead of changes only.\n\nDefault: true"
        }
      },
      "additionalProperties": false
    },
    "GitHunkStyleSetting": {
      "oneOf": [
        {
          "type": "string",
          "const": "staged_hollow",
          "description": "Show unstaged hunks with a filled background and staged hunks hollow."
        },
        {
          "type": "string",
          "const": "unstaged_hollow",
          "description": "Show unstaged hunks hollow and staged hunks with a filled background."
        }
      ]
    },
    "GitDiffBaseSetting": {
      "oneOf": [
        {
          "type": "string",
          "const": "head",
          "description": "Diff against HEAD: show working (uncommitted) changes."
        },
        {
          "type": "string",
          "const": "default_branch",
          "description": "Diff against the merge base between HEAD and the repository's\ndefault branch: show all changes on the branch.\n\nRepositories where no default branch can be resolved fall back\nto `head` behavior."
        }
      ]
    },
    "GitPathStyle": {
      "oneOf": [
        {
          "type": "string",
          "const": "file_name_first",
          "description": "Show file name first, then path"
        },
        {
          "type": "string",
          "const": "file_path_first",
          "description": "Show full path first"
        }
      ]
    },
    "GlobalLspSettingsContent": {
      "type": "object",
      "properties": {
        "button": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to show the LSP servers button in the status bar.\n\nDefault: `true`"
        },
        "request_timeout": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "The maximum amount of time to wait for responses from language servers, in seconds.\nA value of `0` will result in no timeout being applied (causing all LSP responses to wait indefinitely until completed).\n\nDefault: `120`"
        },
        "max_buffer_line_length": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1,
          "description": "The maximum line length a buffer may contain before language server features are disabled for the entire buffer.\n\nDefault: `20000`"
        },
        "notifications": {
          "anyOf": [
            {
              "$ref": "#/$defs/LspNotificationSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings for language server notifications"
        },
        "semantic_token_rules": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticTokenRules"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rules for rendering LSP semantic tokens."
        }
      },
      "description": "Common language server settings.",
      "additionalProperties": false
    },
    "LspNotificationSettingsContent": {
      "type": "object",
      "properties": {
        "dismiss_timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "Timeout in milliseconds for automatically dismissing language server notifications.\nSet to 0 to disable auto-dismiss.\n\nDefault: 5000"
        }
      },
      "additionalProperties": false
    },
    "SemanticTokenRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticTokenRule"
      },
      "description": "Custom rules for rendering LSP semantic tokens."
    },
    "SemanticTokenRule": {
      "type": "object",
      "properties": {
        "token_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_modifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "style": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "foreground_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgba"
            },
            {
              "type": "null"
            }
          ]
        },
        "background_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rgba"
            },
            {
              "type": "null"
            }
          ]
        },
        "underline": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticTokenColorOverride"
            },
            {
              "type": "null"
            }
          ]
        },
        "strikethrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticTokenColorOverride"
            },
            {
              "type": "null"
            }
          ]
        },
        "font_weight": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticTokenFontWeight"
            },
            {
              "type": "null"
            }
          ]
        },
        "font_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticTokenFontStyle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Rgba": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "SemanticTokenColorOverride": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Rgba"
        }
      ]
    },
    "SemanticTokenFontWeight": {
      "type": "string",
      "enum": [
        "normal",
        "bold"
      ]
    },
    "SemanticTokenFontStyle": {
      "type": "string",
      "enum": [
        "normal",
        "italic"
      ]
    },
