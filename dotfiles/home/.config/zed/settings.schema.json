    "LanguageSettingsContent": {
      "type": "object",
      "properties": {
        "tab_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1,
          "description": "How many columns a tab should occupy.\n\nDefault: 4",
          "maximum": 128
        },
        "hard_tabs": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to indent lines using tab characters, as opposed to multiple\nspaces.\n\nDefault: false"
        },
        "soft_wrap": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoftWrap"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to soft-wrap long lines of text.\n\nDefault: none"
        },
        "soft_wrap_indent": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoftWrapIndent"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to indent soft-wrapped continuation lines.\n\nDefault: same"
        },
        "preferred_line_length": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "The column at which to soft-wrap lines, for buffers where soft-wrap\nis enabled.\n\nDefault: 80"
        },
        "show_wrap_guides": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to show wrap guides in the editor. Setting this to true will\nshow a guide at the 'preferred_line_length' value if softwrap is set to\n'preferred_line_length', and will show any additional guides as specified\nby the 'wrap_guides' setting.\n\nDefault: true"
        },
        "wrap_guides": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "description": "Character counts at which to show wrap guides in the editor.\n\nDefault: []"
        },
        "indent_guides": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndentGuideSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Indent guide related settings."
        },
        "format_on_save": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatOnSave"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether or not to perform a buffer format before saving.\n\nDefault: off"
        },
        "remove_trailing_whitespace_on_save": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether or not to remove any trailing whitespace from lines of a buffer\nbefore saving it.\n\nDefault: true"
        },
        "ensure_final_newline_on_save": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether or not to ensure there's a single newline at the end of a buffer\nwhen saving it.\n\nDefault: true"
        },
        "line_ending": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineEndingSetting"
            },
            {
              "type": "null"
            }
          ],
          "description": "How line endings should be handled for new files and during format and\nsave operations.\n\n- `detect`: Detect existing line endings and otherwise use the platform\n  default (`lf` on Unix, `crlf` on Windows).\n- `prefer_lf`: Prefer LF for new files and files with no existing line\n  ending.\n- `prefer_crlf`: Prefer CRLF for new files and files with no existing\n  line ending.\n- `enforce_lf`: Enforce LF during format and save.\n- `enforce_crlf`: Enforce CRLF during format and save.\n\nThe EditorConfig `end_of_line` property overrides this setting and\nbehaves like `enforce_lf` or `enforce_crlf`.\n\nDefault: detect"
        },
        "formatter": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatterList"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to perform a buffer format.\n\nDefault: auto"
        },
        "prettier": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrettierSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Zed's Prettier integration settings.\nAllows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\n\nDefault: off"
        },
        "jsx_tag_auto_close": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsxTagAutoCloseSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether to automatically close JSX tags."
        },
        "enable_language_server": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to use language servers to provide code intelligence.\n\nDefault: true"
        },
        "language_servers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "The list of language servers to use (or disable) for this language.\n\nThis array should consist of language server IDs, as well as the following\nspecial tokens:\n- `\"!<language_server_id>\"` - A language server ID prefixed with a `!` will be disabled.\n- `\"...\"` - A placeholder to refer to the **rest** of the registered language servers for this language.\n\nDefault: [\"...\"]"
        },
        "semantic_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticTokens"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controls how semantic tokens from language servers are used for syntax highlighting.\n\nOptions:\n- \"off\": Do not request semantic tokens from language servers.\n- \"combined\": Use LSP semantic tokens together with tree-sitter highlighting.\n- \"full\": Use LSP semantic tokens exclusively, replacing tree-sitter highlighting.\n\nDefault: \"off\""
        },
        "document_folding_ranges": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentFoldingRanges"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controls whether folding ranges from language servers are used instead of\ntree-sitter and indent-based folding.\n\nOptions:\n- \"off\": Use tree-sitter and indent-based folding (default).\n- \"on\": Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server.\n\nDefault: \"off\""
        },
        "document_symbols": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentSymbols"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controls the source of document symbols used for outlines and breadcrumbs.\n\nOptions:\n- \"off\": Use tree-sitter queries to compute document symbols (default).\n- \"on\": Use the language server's `textDocument/documentSymbol` LSP response. When enabled, tree-sitter is not used for document symbols.\n\nDefault: \"off\""
        },
        "allow_rewrap": {
          "anyOf": [
            {
              "$ref": "#/$defs/RewrapBehavior"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controls where the `editor::Rewrap` action is allowed for this language.\n\nNote: This setting has no effect in Vim mode, as rewrap is already\nallowed everywhere.\n\nDefault: \"in_comments\""
        },
        "show_edit_predictions": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Controls whether edit predictions are shown immediately (true)\nor manually by triggering `editor::ShowEditPrediction` (false).\n\nDefault: true"
        },
        "edit_predictions_disabled_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/SplicingVec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Disable edit predictions in these language scopes, such as \"comment\" and\n\"string\".\n\nDefault:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` to add scopes without repeating the inherited list. In project\nsettings, it extends the user or parent configuration value. In\nlanguage-specific settings, it extends the scopes inherited by that\nlanguage. Omit `\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nInherited scopes are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged."
        },
        "show_whitespaces": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShowWhitespaceSetting"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether to show tabs and spaces in the editor."
        },
        "whitespace_map": {
          "anyOf": [
            {
              "$ref": "#/$defs/WhitespaceMapContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Visible characters used to render whitespace when show_whitespaces is enabled.\n\nDefault: \"•\" for spaces, \"→\" for tabs."
        },
        "extend_comment_on_newline": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to start a new line with a comment when a previous line is a comment as well.\n\nDefault: true"
        },
        "extend_list_on_newline": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to continue markdown lists when pressing enter.\n\nDefault: true"
        },
        "indent_list_on_tab": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to indent list items when pressing tab after a list marker.\n\nDefault: true"
        },
        "inlay_hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/InlayHintSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inlay hint related settings."
        },
        "use_autoclose": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to automatically type closing characters for you. For example,\nwhen you type '(', Zed will automatically add a closing ')' at the correct position.\n\nDefault: true"
        },
        "use_auto_surround": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to automatically surround text with characters for you. For example,\nwhen you select text and type '(', Zed will automatically surround text with ().\n\nDefault: true"
        },
        "always_treat_brackets_as_autoclosed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Controls how the editor handles the autoclosed characters.\nWhen set to `false`(default), skipping over and auto-removing of the closing characters\nhappen only for auto-inserted characters.\nOtherwise(when `true`), the closing characters are always skipped over and auto-removed\nno matter how they were inserted.\n\nDefault: false"
        },
        "use_on_type_format": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to use additional LSP queries to format (and amend) the code after\nevery \"trigger\" symbol input, defined by LSP server capabilities.\n\nDefault: true"
        },
        "code_actions_on_format": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Which code actions to run on save before the formatter.\nThese are not run if formatting is off.\n\nDefault: {} (or {\"source.organizeImports\": true} for Go)."
        },
        "linked_edits": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to perform linked edits of associated ranges, if the language server supports it.\nFor example, when editing opening <html> tag, the contents of the closing </html> tag will be edited as well.\n\nDefault: true"
        },
        "auto_indent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoIndentMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controls automatic indentation behavior when typing.\n\n- \"syntax_aware\": Adjusts indentation based on syntax context (default)\n- \"preserve_indent\": Preserves current line's indentation on new lines\n- \"none\": No automatic indentation\n\nDefault: syntax_aware"
        },
        "auto_indent_on_paste": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether indentation of pasted content should be adjusted based on the context.\n\nDefault: true"
        },
        "tasks": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageTaskSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Task configuration for this language.\n\nDefault: {}"
        },
        "show_completions_on_input": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to pop the completions menu while typing in an editor without\nexplicitly requesting it.\n\nDefault: true"
        },
        "show_completion_documentation": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to display inline and alongside documentation for items in the\ncompletions menu.\n\nDefault: true"
        },
        "completions": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionSettingsContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controls how completions are processed for this language."
        },
        "debuggers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Preferred debuggers for this language.\n\nDefault: []"
        },
        "word_diff_enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to enable word diff highlighting in the editor.\n\nWhen enabled, changed words within modified lines are highlighted\nto show exactly what changed.\n\nDefault: true"
        },
        "colorize_brackets": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to use tree-sitter bracket queries to detect and colorize the brackets in the editor.\n\nDefault: false"
        }
      },
      "description": "The settings for a particular language.",
      "additionalProperties": false
    },
