              "items": {
                "type": "string"
              },
              "default": []
            },
            "env": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "description": "Timeout for tool calls in seconds. Defaults to 60 if not specified."
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether the context server is enabled.",
              "default": true
            },
            "url": {
              "type": "string",
              "description": "The URL of the remote context server."
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Optional headers to send."
            },
            "timeout": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "description": "Timeout for tool calls in seconds. Defaults to global context_server_timeout if not specified."
            },
            "oauth": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OAuthClientSettings"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Pre-registered OAuth client credentials for authorization servers that\nrequire out-of-band client registration."
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether the context server is enabled.",
              "default": true
            },
            "remote": {
              "type": "boolean",
              "description": "Whether to run the context server on the remote server when using remote development.\n\nIf this is false, the context server will always run on the local machine.\n\nDefault: false",
              "default": false
            },
            "settings": {
              "description": "The settings for this context server specified by the extension.\n\nConsult the documentation for the context server to see what settings\nare supported.",
              "default": null
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "OAuthClientSettings": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "description": "The OAuth client ID obtained from out-of-band registration with the\nauthorization server."
        },
        "client_secret": {
          "type": [
            "string",
            "null"
          ],
          "description": "The OAuth client secret, if this is a confidential client. For security,\nprefer providing this interactively; we will prompt and store it in\nthe system keychain."
