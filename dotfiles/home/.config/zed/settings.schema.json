          "minimum": 1,
          "description": "How many columns a tab should occupy.\n\nDefault: 4",
          "maximum": 128
        },
        "hard_tabs": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to indent lines using tab characters, as opposed to multiple\nspaces.\n\nDefault: false"
        },
        "soft_wrap": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoftWrap"
            },
            {
