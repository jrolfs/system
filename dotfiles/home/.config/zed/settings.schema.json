    "AutoCompactSettingsContent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to automatically compact the agent's context when it grows too\nlarge, summarizing earlier messages to free up room in the model's\ncontext window.\n\nDefault: true"
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoCompactThreshold"
            },
            {
              "type": "null"
            }
          ],
          "description": "The threshold at which auto-compaction runs. This is one of:\n\n- A percentage string ending in `%`, e.g. `\"90%\"`, measured against the\n  model's context window. `\"90%\"` compacts once the context is 90% full.\n- A positive integer: compaction runs once that many tokens have been\n  used. For example, `100000` compacts after 100,000 tokens are used.\n- A negative integer: compaction runs once that many tokens remain in\n  the context window. For example, `-20000` compacts once there are\n  fewer than 20,000 tokens of headroom left in the context window.\n\n`0` is not a valid threshold.\n\nDefault: \"90%\""
        }
      },
      "additionalProperties": false
    },
    "AutoCompactThreshold": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?%$"
        },
        {
          "type": "integer"
        }
      ]
    },
    "ThinkingBlockDisplay": {
      "oneOf": [
        {
          "type": "string",
          "const": "auto",
          "description": "Thinking blocks fully expand during streaming, then auto-collapse\nwhen the model finishes thinking. Users can re-expand after collapse."
        },
        {
          "type": "string",
          "const": "preview",
          "description": "Thinking blocks auto-expand with a height constraint during streaming,\nthen remain in their constrained state when complete. Users can click\nto fully expand or collapse."
        },
        {
          "type": "string",
          "const": "always_expanded",
          "description": "Thinking blocks are always fully expanded by default (no height constraint)."
        },
        {
          "type": "string",
          "const": "always_collapsed",
          "description": "Thinking blocks are always collapsed by default."
        }
      ],
      "description": "How thinking blocks should be displayed by default in the agent panel."
    },
    "ToolPermissionsContent": {
      "type": "object",
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolPermissionMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Global default permission when no tool-specific rules match.\nIndividual tools can override this with their own default.\nDefault: confirm"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ToolRulesContent"
          },
          "description": "Per-tool permission rules.\nKeys are tool names (e.g. terminal, edit_file, fetch) including MCP\ntools (e.g. mcp:server_name:tool_name). Any tool name is accepted;\neven tools without meaningful text input can have a `default` set.",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "ToolPermissionMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "allow",
          "description": "Auto-approve without prompting."
        },
        {
          "type": "string",
          "const": "deny",
          "description": "Auto-reject with an error."
        },
        {
          "type": "string",
          "const": "confirm",
          "description": "Always prompt for confirmation (default behavior)."
        }
      ]
    },
    "ToolRulesContent": {
      "type": "object",
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolPermissionMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Default mode when no regex rules match.\nWhen unset, inherits from the global `tool_permissions.default`."
        },
        "always_allow": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtendingVec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Regexes for inputs to auto-approve.\nFor terminal: matches command. For file tools: matches path. For fetch: matches URL.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
        },
        "always_deny": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtendingVec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Regexes for inputs to auto-reject.\n**SECURITY**: These take precedence over ALL other rules, across ALL settings layers.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
        },
        "always_confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtendingVec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Regexes for inputs that must always prompt.\nTakes precedence over always_allow but not always_deny.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
        }
      },
      "additionalProperties": false
    },
    "ExtendingVec3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolRegexRule"
      }
    },
    "ToolRegexRule": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "The regex pattern to match.",
          "default": ""
        },
        "case_sensitive": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the regex is case-sensitive.\nDefault: false (case-insensitive)"
        }
      },
      "additionalProperties": false
    },
    "SandboxPermissionsContent": {
      "type": "object",
      "properties": {
        "allow_all_hosts": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether sandboxed terminal commands may always reach any host over the\nnetwork without prompting.\nDefault: false"
        },
        "network_hosts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtendingVec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hosts that sandboxed terminal commands may always reach over the\nnetwork without prompting. Each entry is an exact hostname\n(`github.com`) or a leading-`*.` subdomain wildcard (`*.npmjs.org`).\nDefault: []"
        },
        "allow_fs_write_all": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether sandboxed terminal commands may always write anywhere on the\nfilesystem without prompting.\nDefault: false"
        },
        "allow_unsandboxed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to persistently run agent terminal commands outside the OS\nsandbox. This is the model-facing \"off switch\": when true, the sandboxed\nterminal tool is not exposed and the system prompt omits the sandbox\nsection, so the model uses the plain `terminal` tool. On Windows, WSL\nsandbox setup is skipped. Distinct from the model-requested\n`unsandboxed: true` escape approved \"once\" or \"for this thread\".\nDefault: false"
        },
        "write_paths": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtendingVec4"
            },
            {
              "type": "null"
            }
          ],
          "description": "Directory subtrees that sandboxed terminal commands may always write\nto without prompting. Each entry is either a bare path string or an\nobject `{requested, resolved}`; Zed writes objects (the canonical,\nsymlink-resolved target established at approval time), while\nhand-authored entries may be bare path strings. Paths written by Zed\nare absolute.\nDefault: []"
        },
        "warn_confusable_unicode": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to warn when a sandbox escalation prompt requests a domain or\nwrite path that contains potentially confusable Unicode characters\n(homoglyphs, invisible characters, or bidirectional overrides). When\nenabled, such prompts show a warning that must be acknowledged before\nthe request can be allowed.\nDefault: true"
        },
        "warn_ntfs_grants": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether to warn (Windows/WSL only) when a sandbox grant targets a file on\na Windows-hosted (DrvFs) filesystem. Such grants are enforced inside WSL\nvia a translated path, and their sandbox-integrity guarantees are weaker\nthan a distro-native filesystem. When enabled, such grants show a warning\nthat must be acknowledged before the command runs.\nDefault: true"
        }
      },
      "additionalProperties": false
    },
    "ExtendingVec4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GrantedWritePathContent"
      }
    },
    "GrantedWritePathContent": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
