#!/usr/bin/env bash
# Move worktrees to where worktree-path now puts them, taking along the state
# that is filed under a worktree's path.
#
# `wt step relocate` moves the directory, and nothing else follows it. Claude
# Code, for one, keeps a project's threads in a store named after its working
# directory, so a moved worktree's threads stop listing under /resume. Worktrunk
# has no hook that fires on relocate, so this wraps it: it records every
# worktree's path from git before and after, then hands each pair that changed
# to the steps below.
#
# `wt handoff` snapshots follow too, and not only for worktrees moved here:
# every run renames any snapshot left at a path its worktree no longer has,
# however the worktree got moved. So a bare run with nothing out of place still
# tidies those up, and is safe to repeat.
#
# Like `wt step relocate`, it moves every worktree whose path doesn't match the
# template unless branches are named, so preview first. To keep a worktree where
# it is for good, `git worktree lock` it: relocate skips locked worktrees,
# though a preview still lists them as if they would move.
#
# Close any agent session running in a worktree before moving it. Re-keying a
# store that a live session is still writing to loses whatever it writes next.
#
#   wt relocate --preview           what would move, and where
#   wt relocate                     move every mismatched worktree
#   wt relocate <branch>...         move just those
#
# --commit and --clobber are passed through to `wt step relocate`. The preview
# is --preview rather than --dry-run because worktrunk refuses a bare
# --dry-run after an alias name; wt-handoff and wt-restore take it too.

set -euo pipefail

# One function per kind of state filed under a worktree's path. Each is called
# with the old and new path of a worktree that moved, and returns quietly when
# it has nothing under the old one. Another agent harness is another function
# here.
steps=(claude_code)

# The store name is the path with every character that isn't a letter or digit
# turned into a dash, the same munging claude-mv-project's slugFor does.
claude_code() {
  [ -d "$HOME/.claude/projects/${1//[^a-zA-Z0-9]/-}" ] || return 0
  claude-mv-project "$1" "$2"
}

# A `wt handoff` snapshot is named after the worktree's directory and records its
# path, which is where `wt restore` recreates it. One recorded at a path its
# worktree has moved away from would bring the worktree back there, so it is
# matched up with the worktree by branch: a snapshot of a branch checked out
# here, recorded at a path under this home that no longer exists. Paths outside
# this home are another machine's layout (irulan's /home) and are left alone.
snapshots() {
  local mode=$1 remote table branch path ref recorded_branch recorded on_origin target

  if ! git fetch --quiet origin "+refs/wip/*:refs/wip/*" 2>/dev/null; then
    echo "▲ Could not fetch handoff snapshots from origin; left them as they are" >&2
    return 0
  fi
  [ "$mode" = preview ] || remote=$(git ls-remote origin 'refs/wip/*' | cut -f2)
  table=$(git for-each-ref \
    --format='%(refname)%09%(trailers:key=Wt-Branch,valueonly,separator=%x2C)%09%(trailers:key=Wt-Path,valueonly,separator=%x2C)' \
    refs/wip/)

  while IFS=$'\t' read -r branch path; do
    while IFS=$'\t' read -r ref recorded_branch recorded; do
      [ "$recorded_branch" = "$branch" ] && [ "$recorded" != "$path" ] || continue
      case $recorded in "$HOME"/*) ;; *) continue ;; esac
      [ ! -e "$recorded" ] || continue

      # A worktree the preview says would move still has its old path, so its
      # snapshot only shows up here once it has actually moved.
      if [ "$mode" = preview ]; then
        target=$(snapshot_name "$path")
        if [ "refs/wip/$target" != "$ref" ] && git rev-parse --verify --quiet "refs/wip/$target" >/dev/null; then
          echo "  would leave handoff snapshot ${ref#refs/wip/} as it is: $target already exists"
        else
          echo "  would move handoff snapshot ${ref#refs/wip/} to $target, restoring to $path"
        fi
        continue
      fi
      on_origin=no
      grep -qxF "$ref" <<<"$remote" && on_origin=yes
      move_snapshot "$ref" "$path" "$on_origin" || {
        echo "✗ could not move handoff snapshot ${ref#refs/wip/}" >&2
        status=1
      }
    done <<<"$table"
  done <<<"$(worktrees)"
}

# The path is in the snapshot's commit, so the snapshot is replaced by a copy
# recorded at the new path and filed under the new name: same files, same
# author and date, and still marked as the host it came from. Its parents are
# the original's first parent, which restore checks out, and the original
# snapshot itself, so nothing becomes unreachable and the next handoff from the
# new path extends the same chain.
#
# On origin the rename is one atomic push that creates the new name only if it
# is free and removes the old one only if it is still the commit seen here, so
# a handoff pushed from elsewhere in the meantime is never overwritten.
move_snapshot() {
  local old_ref=$1 new_path=$2 on_origin=$3 new_ref commit copy
  new_ref=refs/wip/$(snapshot_name "$new_path")
  commit=$(git rev-parse --verify --quiet "$old_ref") || return 0

  if [ "$new_ref" != "$old_ref" ] && git rev-parse --verify --quiet "$new_ref" >/dev/null; then
    echo "Left handoff snapshot ${old_ref#refs/wip/} as it is: ${new_ref#refs/wip/} already exists" >&2
    return 0
  fi

  copy=$(git log -1 --format=%B "$commit" \
    | sed "1s|.*|wip: ${new_ref#refs/wip/}|" \
    | git interpret-trailers --if-exists replace --trailer "Wt-Path: $new_path" \
    | GIT_AUTHOR_NAME=$(git log -1 --format=%an "$commit") \
      GIT_AUTHOR_EMAIL=$(git log -1 --format=%ae "$commit") \
      GIT_AUTHOR_DATE=$(git log -1 --format=%aI "$commit") \
      GIT_COMMITTER_NAME=$(git log -1 --format=%cn "$commit") \
      GIT_COMMITTER_EMAIL=$(git log -1 --format=%ce "$commit") \
      GIT_COMMITTER_DATE=$(git log -1 --format=%cI "$commit") \
      git commit-tree "$commit^{tree}" -p "$commit^" -p "$commit" -F -)

  if [ "$on_origin" = yes ]; then
    if [ "$new_ref" = "$old_ref" ]; then
      git push --quiet --force-with-lease="$old_ref:$commit" origin "$copy:$old_ref" || return 1
    else
      git push --quiet --atomic \
        --force-with-lease="$new_ref:" --force-with-lease="$old_ref:$commit" \
        origin "$copy:$new_ref" ":$old_ref" || return 1
    fi
  fi

  if [ "$new_ref" = "$old_ref" ]; then
    git update-ref "$new_ref" "$copy" "$commit"
  else
    git update-ref "$new_ref" "$copy" ""
    git update-ref -d "$old_ref" "$commit"
  fi
  echo "Moved handoff snapshot ${old_ref#refs/wip/} to ${new_ref#refs/wip/}, so it restores to $new_path"
}

# Mirrors wt-handoff's key_for: the directory name, with the parent folded in
# when the directory repeats the main checkout's name.
snapshot_name() {
  local name
  name=$(basename "$1")
  if [ "$name" = "$main_dir" ] && [ "$1" != "$main_top" ]; then
    name="$(basename "$(dirname "$1")")-$name"
  fi
  printf '%s' "$name"
}

# Tab-separated `branch path` lines, one per worktree with a branch checked out.
worktrees() {
  git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10) }
    /^branch refs\/heads\// { print substr($0, 19) "\t" path }
  '
}

preview=no
arguments=()
for argument in "$@"; do
  case $argument in
    --preview | --dry-run) preview=yes ;;
    *) arguments+=("$argument") ;;
  esac
done

main_top=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
main_dir=$(basename "$main_top")

if [ $preview = yes ]; then
  wt step relocate --dry-run ${arguments[@]+"${arguments[@]}"}
  snapshots preview
  exit 0
fi

before=$(worktrees)

# A relocate that stops partway may still have moved some worktrees, and their
# state needs to follow. The same goes for a step that fails: keep going so one
# broken store doesn't strand the rest, and report it in the exit status.
status=0
wt step relocate ${arguments[@]+"${arguments[@]}"} || status=$?

after=$(worktrees)
while IFS=$'\t' read -r branch old; do
  new=$(awk -F '\t' -v branch="$branch" '$1 == branch { print $2 }' <<<"$after")
  [ -n "$new" ] && [ "$old" != "$new" ] || continue
  for step in "${steps[@]}"; do
    "$step" "$old" "$new" || {
      echo "✗ $step: could not move state for $branch" >&2
      status=1
    }
  done
done <<<"$before"

snapshots move
exit $status
