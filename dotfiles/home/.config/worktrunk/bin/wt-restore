#!/usr/bin/env bash
# Recreate worktrees pushed by wt-handoff: same path under this machine's home,
# same branch, dirty state overlaid, and claude-sync pulled before any of it so
# each path's Claude sessions are resumable the moment the tree exists. Run from
# anywhere inside the repository (main checkout or any worktree).
#
# A snapshot that carried an OpenCode conversation has it imported into the
# restored worktree once the files are in place. wt-opencode-session decides
# whether a copy already here can be replaced.
#
# Home differs by platform (/Users/<you> on the Macs, /home/<you> on Linux), so
# a path is resolved against this one.
#
# Patterns match the snapshot name, and --all takes every snapshot another host
# pushed, so arriving on a new machine is one command rather than one per
# worktree. Snapshots this host took itself are left out of --all, since
# overlaying a machine's own stale snapshot onto its own tree is never what was
# meant; name one explicitly to restore it anyway.
#
# A worktree that is dirty or has the wrong branch checked out is skipped rather
# than overwritten, and in a batch that is one to leave behind rather than a
# reason to abandon the rest.
set -euo pipefail

all=no
dry=no
patterns=()

while [ $# -gt 0 ]; do
  case $1 in
    --all) all=yes ;;
    -n | --dry-run | --preview) dry=yes ;;
    -h | --help)
      echo "usage: wt restore [--all] [pattern...] [--preview]"
      exit 0
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    *) patterns+=("$1") ;;
  esac
  shift
done

if [ "$all" = no ] && [ ${#patterns[@]} -eq 0 ]; then
  echo "usage: wt restore [--all] [pattern...] [--preview]" >&2
  exit 1
fi

host=$(hostname -s)
main_dir=$(basename "$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -1)")
helper=$(cd "$(dirname "$0")" && pwd)/wt-opencode-session

trailer() {
  git log -1 --format="%(trailers:key=$1,valueonly=true)" "refs/wip/$2" | head -1
}

# The conversation commit a snapshot names, once the fetch has brought it here.
# A later handoff of the same worktree replaces the conversation ref, so an
# older snapshot can name a commit origin no longer has.
session_commit() {
  local commit
  commit=$(trailer Wt-OpenCode "$1")
  [ -n "$commit" ] && git cat-file -e "$commit^{commit}" 2>/dev/null && printf '%s' "$commit"
}

session_id() {
  git log -1 --format='%(trailers:key=Wt-Session,valueonly=true)' "$1" | head -1
}

# A conversation that is skipped on purpose (running here, or carried on here
# since it left) is reported by the helper and isn't a failed restore.
restore_session() {
  local name=$1 path=$2 commit status=0
  if ! commit=$(session_commit "$name"); then
    [ -z "$(trailer Wt-OpenCode "$name")" ] \
      || echo "note: $name's OpenCode session is no longer on origin; a later handoff replaced it" >&2
    return 0
  fi
  if ! command -v opencode >/dev/null 2>&1; then
    echo "note: opencode isn't installed here, so $name's session stays on origin" >&2
    return 0
  fi
  git cat-file blob "$commit:session.json.gz.age" | "$helper" import - "$path" || status=$?
  # Restoring again won't retry: the overlaid worktree is dirty now, and restore
  # skips a dirty worktree.
  if [ "$status" -ne 0 ]; then
    echo "  to import it later: git cat-file blob ${commit:0:12}:session.json.gz.age | $helper import - $path" >&2
  fi
  [ "$status" -ne 1 ]
}

# wt-handoff records `~/…`. Snapshots from before it did carry an absolute path
# under the handing-off machine's home, which is mapped onto this one when the
# user name matches. Mirrored in wt-relocate's local_path.
local_path() {
  local user=${USER:-$(id -un)}
  case $1 in
    "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
    /Users/"$user"/* | /home/"$user"/*) printf '%s/%s' "$HOME" "${1#/*/*/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# The snapshot names are only known after the fetch, so take every ref and pick
# from what landed.
git fetch origin "+refs/wip/*:refs/wip/*" "+refs/wip-opencode/*:refs/wip-opencode/*"

snapshots=()
while IFS= read -r name; do
  snapshots+=("$name")
done < <(git for-each-ref --format='%(refname:strip=2)' refs/wip/)

selected=()
ignored=0

if [ "$all" = yes ]; then
  for name in ${snapshots+"${snapshots[@]}"}; do
    if [ "$(trailer Wt-Host "$name")" = "$host" ]; then
      ignored=$((ignored + 1))
      continue
    fi
    selected+=("$name")
  done
fi

for pattern in ${patterns+"${patterns[@]}"}; do
  matched=no
  for name in ${snapshots+"${snapshots[@]}"}; do
    # shellcheck disable=SC2053  # unquoted so the patterns stay globs. The
    # repo-prefixed name is matched too, so `jamie-fix-*` finds the sibling
    # worktrees without spelling out the repo every time.
    if [[ $name == $pattern || ${name#"$main_dir".} == $pattern ]]; then
      selected+=("$name")
      matched=yes
    fi
  done
  [ "$matched" = yes ] || echo "no snapshot matching '$pattern'" >&2
done

if [ ${#selected[@]} -eq 0 ]; then
  if [ "$ignored" -gt 0 ]; then
    echo "nothing to restore: all $ignored snapshot(s) were taken on $host" >&2
  else
    echo "nothing to restore" >&2
  fi
  exit 1
fi

restore_one() {
  local name=$1
  local wip path branch from parent current commit carrying=

  wip=$(git rev-parse "refs/wip/$name")
  path=$(local_path "$(trailer Wt-Path "$name")")
  branch=$(trailer Wt-Branch "$name")
  from=$(trailer Wt-Host "$name")
  parent=$(git rev-parse "$wip^")

  if [ -z "$path" ] || [ -z "$branch" ]; then
    echo "skipping $name: missing Wt-Path/Wt-Branch trailers" >&2
    return 1
  fi

  if [ "$dry" = yes ]; then
    if commit=$(session_commit "$name"); then
      carrying=", then import OpenCode session $(session_id "$commit")"
    fi
    if [ -d "$path" ]; then
      echo "would overlay $name onto $path (branch $branch, from ${from:-unknown})$carrying"
    else
      echo "would create $path (branch $branch, from ${from:-unknown}) and overlay $name$carrying"
    fi
    return 0
  fi

  if [ ! -d "$path" ]; then
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$path" "$branch"
    else
      git worktree add -b "$branch" "$path" "$parent"
    fi
  fi

  cd "$path"

  current=$(git symbolic-ref --short HEAD)
  if [ "$current" != "$branch" ]; then
    echo "skipping $name: $path has $current checked out, snapshot expects $branch" >&2
    return 1
  fi

  if [ -n "$(git status --porcelain)" ]; then
    echo "skipping $name: $path is dirty, commit or stash before restoring" >&2
    return 1
  fi

  if [ "$(git rev-parse HEAD)" != "$parent" ]; then
    echo "note: $branch is at $(git rev-parse --short HEAD), snapshot parent is ${parent:0:7}; overlaying snapshot anyway"
  fi

  # --no-overlay semantics: worktree files end up exactly matching the snapshot
  # tree, including deletions. Ignored files are untouched (wt's pre-start
  # copy-ignored step owns those).
  git restore --source="$wip" --worktree -- :/

  echo "restored $name at $path (branch $branch, snapshot from ${from:-unknown})"

  restore_session "$name" "$path"
}

# One pull for the whole batch, ahead of the trees, so a restored path's
# sessions are there as soon as it is.
if [ "$dry" = no ] && command -v claude-sync >/dev/null 2>&1; then
  claude-sync pull -q || true
fi

failed=0
for name in "${selected[@]}"; do
  # A fresh `set -e` because errexit is suppressed inside a condition, and each
  # worktree gets a subshell so a restore_one that cd'd away doesn't move the
  # next one.
  if ! (
    set -e
    restore_one "$name"
  ); then
    failed=$((failed + 1))
  fi
done

if [ ${#selected[@]} -gt 1 ]; then
  echo "$((${#selected[@]} - failed)) of ${#selected[@]} snapshot(s) done"
fi

if [ "$ignored" -gt 0 ]; then
  echo "left out $ignored snapshot(s) taken on $host" >&2
fi

[ "$failed" -eq 0 ]
