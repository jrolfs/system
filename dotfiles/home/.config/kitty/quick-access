#!/bin/sh

# Carries out the ⌥⇥ binding. Karabiner decides between show and hide from
# whether the panel is the frontmost application, which is the same pair of
# conditions the binding used before any of this was a panel; this script only
# has to act, and to create the panel when there is not one yet.
#
# `kitten quick-access-terminal` is a toggle, which is why it is not used for
# both: pressing ⌥⇥ with the panel visible but buried under another window
# would hide it, when the point is to raise it.

kitty=/opt/homebrew/bin/kitty
kitten=/opt/homebrew/bin/kitten

# Found by its own process rather than by the newest socket in the directory.
# The panel and an ordinary kitty both listen on the path kitty.conf sets, so a
# kitty started from the Dock owns a socket that answers, and addressing the
# newest one sent every ⌥⇥ to that window instead — which also meant the panel
# could never be created, because a socket replying looked like proof one was
# already running.
panel=$(/usr/bin/pgrep -x kitty-quick-access 2>/dev/null | /usr/bin/head -1)
[ -n "$panel" ] || exec "$kitten" quick-access-terminal

socket="$HOME/.local/share/kitty/socket-$panel"

# The process is up but its socket is not there yet, which is the window
# between launching and binding. Nothing to send to, and starting a second one
# would be worse than doing nothing.
[ -S "$socket" ] || exit 0

case "$1" in
show)
  # Two calls because they do different things. `show` only un-hides: against a
  # window that is merely buried under another application it does nothing at
  # all, which is what made ⌥⇥ look dead. focus-window is what raises and
  # activates. Running both covers hidden and buried alike.
  "$kitty" @ --to "unix:$socket" resize-os-window --action show >/dev/null 2>&1
  exec "$kitty" @ --to "unix:$socket" focus-window
  ;;
hide)
  exec "$kitty" @ --to "unix:$socket" resize-os-window --action hide
  ;;
*)
  echo "usage: quick-access <show|hide>" >&2
  exit 64
  ;;
esac
