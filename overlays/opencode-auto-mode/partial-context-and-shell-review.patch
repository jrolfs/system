-          if (!contextComplete)
-            return { decision: "ask", reason: "User authorization context is unavailable" };
+          // Zed attaches @-mentioned files to user messages, and any session
+          // runs past the transcript window eventually, so treating partial
+          // context as no context sent nearly every action to a prompt.
+          // The reviewer is told instead, and its policy already demands
+          // explicit authorization for this exact action.
+          // With no user message visible at all there is nothing that could
+          // authorize the action, so that case still skips the reviewer.
+          if (!contextComplete) {
+            if (!request.transcript?.startsWith("User messages"))
+              return { decision: "ask", reason: "User authorization context is unavailable" };
