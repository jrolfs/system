 const BALANCED_QUOTES = /^(?:[^'"\\]|\\[^\r\n]|'[^']*'|"(?:[^"\\]|\\[^\r\n])*")*$/;
 
+// Shell syntax the guard can't parse into plain words. Unlike the other asks
+// here, this is not a reason to skip review: it only rules out the static
+// fast path, and the model reviewers still judge the whole command.
+export const UNCERTAIN_SHELL = "Shell syntax requires manual approval";
+
 export function shellWords(command: string): string[] | undefined {
   if (!command || command.length > 4096 || /[$`~\r\n\0{}[\]]/.test(command) ||
       /[^\S \t]/.test(command) || !BALANCED_QUOTES.test(command)) return undefined;
