 func (s *Syncer) handleConflict(ctx context.Context, relativePath string, remoteObj storage.ObjectInfo) error {
-	s.log("Conflict detected: %s (keeping local, saving remote as .conflict)", relativePath)
-
-	// Download remote version with conflict suffix
-	conflictPath := relativePath + ".conflict." + time.Now().Format("20060102-150405")
-	if err := s.downloadFile(ctx, conflictPath, remoteObj.Key, nil); err != nil {
+	remote, err := s.fetchDecoded(ctx, relativePath, remoteObj.Key)
+	if err != nil {
 		return fmt.Errorf("failed to save conflict file: %w", err)
 	}
+	fullPath := filepath.Join(s.claudeDir, relativePath)
+
+	// Both sides changed to the same bytes. Record that, or every later pull
+	// sees "remote newer, local changed" again and writes another copy.
+	if local, rerr := os.ReadFile(fullPath); rerr == nil && bytes.Equal(local, remote) {
+		if info, serr := os.Stat(fullPath); serr == nil {
+			s.state.UpdateFile(relativePath, info, HashBytes(local))
+			s.state.MarkUploaded(relativePath)
+		}
+		return nil
+	}
 
+	// The state is deliberately left alone below, so the conflict stays
+	// visible until it is resolved. That means it is re-detected on every
+	// pull, and a copy identical to the last one parked adds nothing.
+	if latest := latestConflictArtifact(fullPath); latest != "" {
+		if parked, rerr := os.ReadFile(latest); rerr == nil && bytes.Equal(parked, remote) {
+			return nil
+		}
+	}
+
+	s.log("Conflict detected: %s (keeping local, saving remote as .conflict)", relativePath)
+	conflictPath := fullPath + ".conflict." + time.Now().Format("20060102-150405")
+	if err := os.WriteFile(conflictPath, remote, 0600); err != nil {
+		return fmt.Errorf("failed to save conflict file: %w", err)
+	}
 	return nil
 }
 
+// latestConflictArtifact returns the newest .conflict.<ts> copy of fullPath,
+// or "" when there is none. The timestamp suffix sorts chronologically.
+func latestConflictArtifact(fullPath string) string {
+	matches, _ := filepath.Glob(fullPath + ".conflict.*")
+	latest := ""
+	for _, m := range matches {
+		if conflictArtifactRe.MatchString(filepath.Base(m)) && m > latest {
+			latest = m
+		}
+	}
+	return latest
+}
