+package sync
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func conflictArtifacts(t *testing.T, dir, name string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("ReadDir failed: %v", err)
+	}
+	var found []string
+	for _, e := range entries {
+		if strings.HasPrefix(e.Name(), name+".conflict.") {
+			found = append(found, e.Name())
+		}
+	}
+	return found
+}
+
+func divergeSettings(t *testing.T, env *testEnv, local, remote string) {
+	t.Helper()
+	ctx := context.Background()
+	writeFile(t, env.claudeDir, "settings.json", "line1\n")
+	if _, err := env.syncer.Push(ctx); err != nil {
+		t.Fatalf("Push failed: %v", err)
+	}
+	writeFile(t, env.claudeDir, "settings.json", local)
+	encrypted, _ := env.syncer.encryptor.Encrypt([]byte(remote))
+	time.Sleep(10 * time.Millisecond)
+	if err := env.store.Upload(ctx, "settings.json.age", encrypted); err != nil {
+		t.Fatalf("Upload to mock failed: %v", err)
+	}
+}
+
+func TestRepeatedPullsParkOneConflictCopy(t *testing.T) {
+	env := setupTestEnv(t)
+	ctx := context.Background()
+	divergeSettings(t, env, "line1\nlocal\n", "line1\nremote\n")
+
+	for i := 0; i < 3; i++ {
+		if _, err := env.syncer.Pull(ctx); err != nil {
+			t.Fatalf("Pull %d failed: %v", i, err)
+		}
+		// Artifact names have one-second resolution.
+		time.Sleep(1100 * time.Millisecond)
+	}
+
+	if found := conflictArtifacts(t, env.claudeDir, "settings.json"); len(found) != 1 {
+		t.Fatalf("Expected 1 conflict copy after repeated pulls, got %d: %v", len(found), found)
+	}
+}
+
+func TestIdenticalChangesAreNotAConflict(t *testing.T) {
+	env := setupTestEnv(t)
+	ctx := context.Background()
+	divergeSettings(t, env, "line1\nsame\n", "line1\nsame\n")
+
+	if _, err := env.syncer.Pull(ctx); err != nil {
+		t.Fatalf("Pull failed: %v", err)
+	}
+	if found := conflictArtifacts(t, env.claudeDir, "settings.json"); len(found) != 0 {
+		t.Fatalf("Expected no conflict copy for identical content, got %v", found)
+	}
+
+	result, err := env.syncer.Pull(ctx)
+	if err != nil {
+		t.Fatalf("Second pull failed: %v", err)
+	}
+	if len(result.Conflicts) != 0 {
+		t.Fatalf("Expected identical content to stay resolved, got conflicts %v", result.Conflicts)
+	}
+}
