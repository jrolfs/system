{ lib, pkgs, osConfig, ... }:

# The top bar, a Quickshell config: workspaces and the focused window's title
# on the left, the clock in the middle, audio and Bluetooth on the right.
#
# The QML is static files beside this one. Everything visual they use comes
# from Theme.qml, which is generated here from the shared palette and fonts,
# so the QML never names a colour or a typeface itself.

let
  palette = (import ../../../../theme/palette.nix).dark.soft;
  fonts = import ../../../../theme/fonts.nix;

  look = {
    height = 34;
    padding = 12;
    spacing = 14;
    rounding = 8;
    # Background alpha as a hex byte, ARGB-style for QML. Lower than the
    # launcher's, since the bar is glanced at rather than read, and Hyprland
    # blurs whatever shows through it.
    alpha = "99";
    fontSize = 13;
    iconSize = 16;
  };

  argb = alpha: hex: "#${alpha}${lib.removePrefix "#" hex}";

  theme = pkgs.writeText "Theme.qml" ''
    pragma Singleton

    import Quickshell
    import QtQuick

    // Generated by modules/home/linux/desktop/bar/default.nix.
    Singleton {
      readonly property color background: "${argb look.alpha palette.bg_dim}"
      readonly property color surface: "${palette.bg1}"
      readonly property color foreground: "${palette.fg0}"
      readonly property color muted: "${palette.grey1}"
      readonly property color accent: "${palette.yellow}"
      readonly property color accentForeground: "${palette.bg0}"
      readonly property color urgent: "${palette.red}"

      readonly property string sans: "${fonts.sans.family}"
      // Phosphor's regular weight. Icons are text in this face, by codepoint.
      readonly property string icons: "Phosphor"

      readonly property int height: ${toString look.height}
      readonly property int padding: ${toString look.padding}
      readonly property int spacing: ${toString look.spacing}
      readonly property int rounding: ${toString look.rounding}
      readonly property int fontSize: ${toString look.fontSize}
      readonly property int iconSize: ${toString look.iconSize}
    }
  '';

  config = pkgs.linkFarm "quickshell-bar" [
    { name = "shell.qml"; path = ./shell.qml; }
    { name = "Bar.qml"; path = ./Bar.qml; }
    { name = "Workspaces.qml"; path = ./Workspaces.qml; }
    { name = "Audio.qml"; path = ./Audio.qml; }
    { name = "BluetoothStatus.qml"; path = ./BluetoothStatus.qml; }
    { name = "Icon.qml"; path = ./Icon.qml; }
    { name = "Theme.qml"; path = theme; }
  ];
in
lib.mkIf (osConfig.desktop.enable or false) {
  programs.quickshell = {
    enable = true;
    configs.bar = config;
    activeConfig = "bar";
    systemd.enable = true;
  };
}
