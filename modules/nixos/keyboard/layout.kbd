;; The keyboard layout, written to load unchanged on macOS too: everything
;; but `defcfg`, which each OS supplies (NixOS generates it in
;; modules/nixos/keyboard). On the Macs this is what karabiner/karabiner.json
;; does today.
;;
;; Layers:
;;   plain     the base layer, and the one kanata starts in: Caps, Tab, right
;;             ⌥ and right Ctrl change, ⌘ doesn't. This is what the text
;;             console gets, where ⌘C turned into Ctrl+C would be an
;;             interrupt, and what kitty gets, which binds ⌘ itself. On macOS
;;             it's the only base layer ever active.
;;   mac       the base layer in Hyprland while anything but kitty is focused
;;             (switched over kanata's TCP port by hypr-kanata-layers): ⌘
;;             chords become the Ctrl shortcuts Linux apps expect
;;   cmd       held ⌘ in `mac`
;;   fn        held Tab: hjkl are arrows
;;   alt       held ⌥ in `mac`: ←→⌫ act on words
;;
;; ⌥Space is left alone. Hyprland binds it to its window mode, the way Moom
;; binds it on the Mac (modules/home/linux/desktop/hyprland.nix).

(defsrc
  1      2      3      4      5      6      7      8      9
  tab    q      w      e      r      t      y      u      i      o      p
  caps   a      s      d      f      g      h      j      k      l
  z      x      c      v      b      n      comm
  lalt   lmet   spc    rmet   ralt   rctl
  bspc   left   rght
)

(defvar
  ;; Long enough that a fast typist's Tab or Caps isn't read as a hold.
  tap 200
  hold 200
)

(defalias
  ;; Caps: Escape on its own, Ctrl held. Karabiner mapped Caps to right Ctrl
  ;; and gave right Ctrl the tap-for-Escape behaviour, so both behave alike.
  caps (tap-hold $tap $hold esc lctl)
  rctl (tap-hold $tap $hold esc rctl)

  ;; Tab: Tab on its own, the arrows layer held.
  tab (tap-hold $tap $hold tab (layer-while-held fn))

  ;; Right ⌥: Hyper held, ⌃⌥A on its own (Karabiner's "Right ⌥ to Hyper").
  hyper (tap-hold $tap $hold C-A-a (multi lctl lalt lmet lsft))

    ;; ⌘ stays pressed (so ⌘+Space, ⌘+arrows and anything unlisted still reach
  ;; the compositor as Super) while the cmd layer swaps the listed keys for
  ;; their Ctrl equivalents.
  cmd (multi lmet (layer-while-held cmd))

  ;; ⌥ stays pressed too, while ⌥←, ⌥→ and ⌥⌫ move and delete by word, as
  ;; on the Mac: Linux spells those with Ctrl, and Ctrl+← and Ctrl+→
  ;; themselves belong to the window manager, switching workspaces as they
  ;; switch Spaces.
  alt (multi lalt (layer-while-held alt))

  ;; ⌘+letter as Ctrl+letter, with ⌘ released for the duration so the app
  ;; sees Ctrl alone. Shift is left alone, so ⌘⇧Z is still redo. H and M are
  ;; missing on purpose: ⌘H and ⌘M hide and minimise on the Mac, which no
  ;; Ctrl shortcut does here, so they stay Super for the compositor.
  c-a (unmod (lmet rmet) lctl a)
  c-b (unmod (lmet rmet) lctl b)
  c-c (unmod (lmet rmet) lctl c)
  c-d (unmod (lmet rmet) lctl d)
  c-e (unmod (lmet rmet) lctl e)
  c-f (unmod (lmet rmet) lctl f)
  c-g (unmod (lmet rmet) lctl g)
  c-i (unmod (lmet rmet) lctl i)
  c-j (unmod (lmet rmet) lctl j)
  c-k (unmod (lmet rmet) lctl k)
  c-l (unmod (lmet rmet) lctl l)
  c-n (unmod (lmet rmet) lctl n)
  c-o (unmod (lmet rmet) lctl o)
  c-p (unmod (lmet rmet) lctl p)
  c-q (unmod (lmet rmet) lctl q)
  c-r (unmod (lmet rmet) lctl r)
  c-s (unmod (lmet rmet) lctl s)
  c-t (unmod (lmet rmet) lctl t)
  c-u (unmod (lmet rmet) lctl u)
  c-v (unmod (lmet rmet) lctl v)
  c-w (unmod (lmet rmet) lctl w)
  c-x (unmod (lmet rmet) lctl x)
  c-y (unmod (lmet rmet) lctl y)
  c-z (unmod (lmet rmet) lctl z)
  ;; ⌘, opens preferences on the Mac, which Ctrl+, does in most editors.
  c-comm (unmod (lmet rmet) lctl comm)
  ;; ⌘⌫ deletes to the start of the line on the Mac; Ctrl+⌫ is a word, the
  ;; nearest common equivalent.
  c-bs (unmod (lmet rmet) lctl bspc)

  word-left (unmod (lalt) lctl left)
  word-right (unmod (lalt) lctl rght)
  word-bs (unmod (lalt) lctl bspc)

  ;; ⌘1-9 picks a tab on the Mac. Glide, being Firefox, uses Alt for that on
  ;; Linux. (Ctrl+1-9 is taken: it switches workspaces, as it switches Spaces
  ;; on the Mac.)
  a-1 (unmod (lmet rmet) lalt 1)
  a-2 (unmod (lmet rmet) lalt 2)
  a-3 (unmod (lmet rmet) lalt 3)
  a-4 (unmod (lmet rmet) lalt 4)
  a-5 (unmod (lmet rmet) lalt 5)
  a-6 (unmod (lmet rmet) lalt 6)
  a-7 (unmod (lmet rmet) lalt 7)
  a-8 (unmod (lmet rmet) lalt 8)
  a-9 (unmod (lmet rmet) lalt 9)
)

(deflayer plain
  _      _      _      _      _      _      _      _      _
  @tab   _      _      _      _      _      _      _      _      _      _
  @caps  _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _
  _      lmet   _      rmet   @hyper @rctl
  _      _      _
)

(deflayer mac
  _      _      _      _      _      _      _      _      _
  @tab   _      _      _      _      _      _      _      _      _      _
  @caps  _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _
  @alt   @cmd   _      @cmd   @hyper @rctl
  _      _      _
)

(deflayer cmd
  @a-1   @a-2   @a-3   @a-4   @a-5   @a-6   @a-7   @a-8   @a-9
  _      @c-q   @c-w   @c-e   @c-r   @c-t   @c-y   @c-u   @c-i   @c-o   @c-p
  _      @c-a   @c-s   @c-d   @c-f   @c-g   _      @c-j   @c-k   @c-l
  @c-z   @c-x   @c-c   @c-v   @c-b   @c-n   @c-comm
  _      _      _      _      _      _
  @c-bs  _      _
)

(deflayer fn
  _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      left   down   up     rght
  _      _      _      _      _      _      _
  _      _      _      _      _      _
  _      _      _
)

(deflayer alt
  _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _
  _      _      _      _      _      _
  @word-bs @word-left @word-right
)
